# ── PaidSure backend ──────────────────────────────────────────────
# Copy to .env for local dev. Never commit the real .env.

# Dev: SQLite file DB (created by `npx prisma db push`).
# Prod: switch to PostgreSQL, e.g. "postgresql://user:pass@host:5432/paidsure"
# (also flip provider in prisma/schema.prisma from "sqlite" to "postgresql")
DATABASE_URL="file:./dev.db"

# Request auth for the merchant dashboard (use a long random string)
JWT_SECRET="dev-only-jwt-secret-change-me"

# Pairing/ingest token for the Android helper (tokens are stored hashed)
DEVICE_TOKEN_SECRET="dev-only-device-secret-change-me"

# Platform admin gate (basic auth for admin routes)
ADMIN_PASSWORD="dev-admin-password"

# HTTP port
PORT=4000

# CORS allowlist (comma-separated origins), e.g. "https://paidsure.example,https://app.example"
# Leave empty to deny all cross-origin requests (dev default — Vite proxy is same-origin).
ALLOWED_ORIGINS=""

# Frontend base URL used to build hosted status-page links (/s/<ref>).
PUBLIC_APP_URL="http://localhost:5173"

# Express trust-proxy hops. Set to 1 when running behind Render/Cloudflare so
# rate limits see the real client IP. Keep 0 for direct local access.
TRUST_PROXY=0

# Local dev only: allow http:// and private-IP webhook targets. Production
# refuses to boot with this enabled (SSRF guard).
ALLOW_PRIVATE_WEBHOOKS=false

# Optional: comma-separated IPs allowed to call /api/admin. Empty = any IP.
ADMIN_IP_ALLOWLIST=""
